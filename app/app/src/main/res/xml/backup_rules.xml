<?xml version="1.0" encoding="utf-8"?><!--
   Quy tắc auto-backup cho thiết bị API < 31.
   QUAN TRỌNG: todo_app_prefs được mã hóa bằng EncryptedSharedPreferences, khóa nằm trong
   Android Keystore và KHÔNG được backup. Nếu backup file mã hóa rồi restore sang máy khác,
   khóa không còn -> không giải mã được -> app crash khi khởi động. Vì vậy phải loại trừ.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="todo_app_prefs.xml"/>
</full-backup-content>

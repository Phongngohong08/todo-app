<?xml version="1.0" encoding="utf-8"?><!--
   Quy tắc backup/transfer cho thiết bị API >= 31.
   Loại trừ todo_app_prefs (EncryptedSharedPreferences) khỏi cloud-backup lẫn device-transfer:
   khóa mã hóa nằm trong Keystore, không đi kèm backup nên bản restore sẽ không giải mã được.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="todo_app_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="todo_app_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>

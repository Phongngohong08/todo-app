# Server Config
PORT=8080
JWT_SECRET=super_secret_key_change_me_in_production

# JWT token lifetimes (Go duration format: 15m, 1h, 720h...)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# PostgreSQL Config
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=todo_db

# Qdrant Vector Database Config
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Gemini Integration Config (Required for AI planning, chat coach, and memory extraction)
GEMINI_API_KEY=your_gemini_api_key_here

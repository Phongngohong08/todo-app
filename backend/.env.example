# Server Config
PORT=8080
# BẮT BUỘC: chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: openssl rand -hex 32
# API từ chối khởi động nếu để trống, ngắn, hoặc dùng giá trị mẫu.
JWT_SECRET=

# JWT token lifetimes (Go duration format: 15m, 1h, 720h...)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Múi giờ của người dùng (tên IANA): giờ chạy job ngầm 01:00/04:00, "hôm nay" khi app không gửi ngày,
# và mốc reset hạn mức AI hằng ngày.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Tự áp các migration còn thiếu trong migrations/ khi API khởi động (true/false)
AUTO_MIGRATE=true

# PostgreSQL Config
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=todo_db

# Qdrant Vector Database Config
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Gemini Integration Config (Required for AI planning, chat coach, and memory extraction)
GEMINI_API_KEY=your_gemini_api_key_here
# Model dùng cho các tính năng AI. Bỏ trống = gemini-2.5-flash.
# Đổi sang gemini-2.5-flash-lite nếu model chính hết hạn mức free tier (mỗi model có 20 lượt/ngày riêng).
GEMINI_MODEL=gemini-2.5-flash

# Giới hạn gọi AI cho MỖI người dùng (chat, quick add, lập lịch, phân tích trí nhớ)
AI_RATE_PER_MINUTE=6
# Tổng lượt AI mỗi ngày; 0 = không giới hạn. Với free tier nên đặt thấp để một người không dùng hết quota chung.
AI_DAILY_LIMIT_PER_USER=30

# IP/CIDR của reverse proxy (Nginx) được tin để đọc IP thật từ X-Forwarded-For (dùng cho rate limit theo IP).
# Mặc định: loopback + mạng Docker bridge.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Origin trình duyệt được phép gọi API (phân tách dấu phẩy). App Android không cần — để trống.
CORS_ALLOWED_ORIGINS=
